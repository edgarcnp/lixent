---
import "../styles/base.css"
import type { PageModel } from "../../core/page/build.ts"
import LicenseView from "../components/LicenseView.astro"

interface Props {
    page: PageModel
}

const { page } = Astro.props
const { head } = page
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
---

<!doctype html>
<html lang="en" style={head.style}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
        <link rel="icon" href={`${base}/favicon.ico`} />
        <meta name="generator" content={Astro.generator} />
        <title>{page.title}</title>
        <meta name="description" content={`${page.title} — ${page.identity.name}`} />
        {head.fontHref && <link rel="preconnect" href="https://fonts.googleapis.com" />}
        {head.fontHref && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
        {head.fontHref && <link rel="stylesheet" href={head.fontHref} />}
        {head.themeHref && <link rel="stylesheet" href={`${base}${head.themeHref}`} />}
    </head>
    <body>
        <LicenseView page={page} />
        <footer class="page-footer">
            Powered by <a href="https://github.com/edgarcnp/lixent">Lixent</a>
        </footer>
    </body>
</html>
