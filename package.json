{
    "name": "lixent",
    "type": "module",
    "version": "1.1.4",
    "description": "A modern, self-hosted license page generator",
    "scripts": {
        "cq": "bun run lint && bun run typecheck && bun run test",
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "bun test",
        "typecheck": "bunx tsc --noEmit"
    },
    "dependencies": {
        "astro": "7.4.12"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@stylistic/eslint-plugin": "6.0.0",
        "@types/node": "26.6.6",
        "eslint": "10.15.0",
        "eslint-plugin-astro": "3.2.1",
        "globals": "17.14.0",
        "typescript-eslint": "8.72.2"
    },
    "overrides": {
        "minimatch": "11.0.8"
    }
}
